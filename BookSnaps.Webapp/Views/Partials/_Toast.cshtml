<div x-data class="toast toast-bottom toast-end" >
    <div :class="$store.toast.toastClass" x-show="$store.toast.isVisible">
        <span x-text="$store.toast.message"></span>
    </div>
</div>


@if (TempData["ToastMessage"] != null) {
    <script>
        document.addEventListener("alpine:initialized", () => {
            const message = @Html.Raw(Json.Serialize(TempData["ToastMessage"]));
            const tempType = @Html.Raw(Json.Serialize(TempData["ToastType"] ?? "Info").ToString().ToLower());

            document.dispatchEvent(new CustomEvent('show-toast', { 
                detail: { message: message, type: tempType }
            }));
        })
    </script>
}